NODE_ENV=production
PORT=3005
# PostgreSQL URL assembled from the generated payment database password.
DATABASE_URL=postgresql://meshly:replace-with-payment-db-password@payment-postgres:5432/meshly_payments?schema=public
# Internal RabbitMQ URL using the generated RabbitMQ password.
RABBITMQ_URL=amqp://meshly:replace-with-rabbitmq-password@rabbitmq:5672
RABBITMQ_EXCHANGE=meshly.events
PAYMENT_QUEUE=payment-service.order-placed
# Test/live secret key from Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret for the production HTTPS webhook; configured in Chunk 4.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd
# Same generated access-token secret used by auth-service.
JWT_ACCESS_SECRET=replace-with-random-access-secret
# Same generated internal key used by order-service.
INTERNAL_SERVICE_KEY=replace-with-random-internal-service-key
# Public HTTPS URLs created from your production domain.
FRONTEND_URL=https://meshly.example.com
CLUB_SUCCESS_URL=https://meshly.example.com/club/success
CLUB_CANCEL_URL=https://meshly.example.com/club/cancelled
CLUB_PORTAL_RETURN_URL=https://meshly.example.com/account
