NODE_ENV=production
PORT=3002
# Internal MongoDB URL from docker-compose.prod.yml.
MONGODB_URI=mongodb://mongodb:27017/meshly_products
# Same generated access-token secret used by auth-service.
JWT_ACCESS_SECRET=replace-with-random-access-secret
# Public HTTPS origin created from your production domain.
CORS_ORIGIN=https://meshly.example.com
