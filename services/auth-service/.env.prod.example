NODE_ENV=production
PORT=3001
# PostgreSQL URL assembled from the generated auth database password.
DATABASE_URL=postgresql://meshly:replace-with-auth-db-password@auth-postgres:5432/meshly_auth?schema=public
# Generate two independent values with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-random-access-secret
JWT_REFRESH_SECRET=replace-with-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Public HTTPS origin created from your production domain.
CORS_ORIGIN=https://meshly.example.com
COOKIE_SECURE=true
