NODE_ENV=production
PORT=3004
# PostgreSQL URL assembled from the generated order database password.
DATABASE_URL=postgresql://meshly:replace-with-order-db-password@order-postgres:5432/meshly_orders?schema=public
# Internal Docker DNS names from docker-compose.prod.yml.
PRODUCT_SERVICE_URL=http://product-service:3002
PAYMENT_SERVICE_URL=http://payment-service:3005
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_KEY=replace-with-random-internal-service-key
# Internal RabbitMQ URL using the generated RabbitMQ password.
RABBITMQ_URL=amqp://meshly:replace-with-rabbitmq-password@rabbitmq:5672
RABBITMQ_EXCHANGE=meshly.events
ORDER_PAYMENT_QUEUE=order-service.payment-events
# Same generated access-token secret used by auth-service.
JWT_ACCESS_SECRET=replace-with-random-access-secret
# Public HTTPS origin created from your production domain.
CORS_ORIGIN=https://meshly.example.com
