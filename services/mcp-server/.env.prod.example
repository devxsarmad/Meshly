# Public or private service URLs reachable from the machine running this stdio MCP server.
PRODUCT_SERVICE_URL=https://meshly.example.com
ORDER_SERVICE_URL=https://meshly.example.com
PAYMENT_SERVICE_URL=https://meshly.example.com
# Same generated access-token secret used by auth-service; required by the current explicit-userId limitation.
JWT_ACCESS_SECRET=replace-with-random-access-secret
# Same generated internal key used by order-service and payment-service.
INTERNAL_SERVICE_KEY=replace-with-random-internal-service-key
