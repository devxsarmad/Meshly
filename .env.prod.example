# Docker Hub account or organization that owns the Meshly service repositories.
DOCKERHUB_USERNAME=your-dockerhub-username
# Release tag pushed by build-and-push.sh; use an immutable version or Git SHA for real releases.
IMAGE_TAG=latest
# Public HTTPS origin configured after DNS/HTTPS setup, without a trailing slash.
PUBLIC_ORIGIN=https://meshly.example.com
# Public API origin embedded into the frontend image; nginx serves `/api` on this origin.
NEXT_PUBLIC_API_URL=https://meshly.example.com
# Bare domain used by nginx and Let's Encrypt, without a scheme or path.
DOMAIN=meshly.example.com
# Address used by Let's Encrypt for expiration and account notices.
LETSENCRYPT_EMAIL=admin@example.com

# Generate each URL-safe password independently with: openssl rand -hex 32
AUTH_DB_PASSWORD=replace-with-random-auth-db-password
ORDER_DB_PASSWORD=replace-with-random-order-db-password
PAYMENT_DB_PASSWORD=replace-with-random-payment-db-password
REDIS_PASSWORD=replace-with-random-redis-password
RABBITMQ_USER=meshly
RABBITMQ_PASSWORD=replace-with-random-rabbitmq-password

# Generate independent application secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-random-access-secret
JWT_REFRESH_SECRET=replace-with-random-refresh-secret
INTERNAL_SERVICE_KEY=replace-with-random-internal-service-key

# Copy test-mode keys from the Stripe Dashboard; the webhook secret is replaced in Chunk 4.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stable production settings; change only when intentionally tuning behavior.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CART_TTL_SECONDS=604800
RABBITMQ_EXCHANGE=meshly.events
ORDER_PAYMENT_QUEUE=order-service.payment-events
PAYMENT_QUEUE=payment-service.order-placed
NOTIFICATION_QUEUE=notification-service.events
STRIPE_CURRENCY=usd
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
