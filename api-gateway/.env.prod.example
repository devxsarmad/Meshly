NODE_ENV=production
PORT=3000
# Internal Docker DNS names from docker-compose.prod.yml.
AUTH_SERVICE_URL=http://auth-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
CART_SERVICE_URL=http://cart-service:3003
ORDER_SERVICE_URL=http://order-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3005
# Public HTTPS origin created from your production domain.
CORS_ORIGIN=https://meshly.example.com
# Same generated access-token secret used by auth and all protected services.
JWT_ACCESS_SECRET=replace-with-random-access-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
